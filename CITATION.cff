    given-names: Dan
    orcid: "https://orcid.org/0000-0001-7007-5807"
    website: "https://cmt.blog/"
license: CC-BY-4.0
doi: "10.5281/zenodo.23371750"
url: "https://dknauss.github.io/cmt-gene-table/"
repository-code: "https://github.com/dknauss/cmt-gene-table"
keywords:
  - Charcot-Marie-Tooth disease
  - inherited neuropathy
  - ClinGen
  - gene-disease validity
  - Mondo
  - rare disease
version: "v2026.10"
date-released: "2026-10-14"
